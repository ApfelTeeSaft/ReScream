{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-win32",
      "displayName": "Visual Studio 2026 - Win32",
      "description": "Build the Scream deliverables with the VS 2026 x86 toolchain.",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "SCREAM_BUILD_SDK": "ON",
        "SCREAM_BUILD_CLIENT": "ON",
        "SCREAM_BUILD_BUNDLE_TOOL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-win32-release",
      "displayName": "Visual Studio 2026 - Win32 Release",
      "configurePreset": "vs2026-win32",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "vs2026-win32-debug",
      "displayName": "Visual Studio 2026 - Win32 Debug",
      "configurePreset": "vs2026-win32",
      "configuration": "Debug",
      "jobs": 8
    }
  ]
}
